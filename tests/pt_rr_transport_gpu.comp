#version 460
#extension GL_GOOGLE_include_directive : require
layout(local_size_x=8,local_size_y=8) in;
layout(set=1,binding=6,rgba8) uniform writeonly image2D resultImage;
layout(push_constant) uniform Constants { vec4 values[8]; } pc;
#ifndef PT_RR_EXPECT_ZERO
vec3 radianceD,radianceS,radianceT,radianceE,diffuseBRDF;
#define pathClass referenceClass
#define resetCompactPath referenceReset
#define addIncident referenceIncident
#define addDirect referenceDirect
#define attenuate referenceAttenuate
#define compactReflect referenceReflect
#define compactTransmit referenceTransmit
#define compactScatter referenceScatter
#define compactThroughput referenceThroughput
#define addAmbient referenceAmbient
#include "pt_compact_transport.glsl"
#include "pt_ambient.glsl"
#undef pathClass
#undef resetCompactPath
#undef addIncident
#undef addDirect
#undef attenuate
#undef compactReflect
#undef compactTransmit
#undef compactScatter
#undef compactThroughput
#undef addAmbient
#include "pt_rr_transport.glsl"
#include "pt_ambient.glsl"
uint rng;
float sampleValue(){rng^=rng<<13;rng^=rng>>17;rng^=rng<<5;return float(rng>>8)/16777216.0;}
vec3 sampleColor(){return vec3(sampleValue(),sampleValue(),sampleValue());}
bool equalTransport(vec3 a,vec3 b){
    return !any(isnan(a)) && !any(isinf(a)) && !any(isnan(b)) && !any(isinf(b)) &&
        all(lessThanEqual(abs(a-b),vec3(0.000002)+max(abs(a),abs(b))*0.00001));
}
#endif
void main(){
    ivec2 p=ivec2(gl_GlobalInvocationID.xy),size=imageSize(resultImage);
    if(any(greaterThanEqual(p,size))) return;
    bool valid=true;
#ifndef PT_RR_EXPECT_ZERO
    rng=uint(p.y*size.x+p.x)*747796405u+floatBitsToUint(pc.values[4].w)+97123u;
    if(rng==0u) rng=1u;
    referenceReset(); resetCompactPath();
    for(uint step=0;step<16u;++step){
        diffuseBRDF=sampleColor();
        vec3 brdf=sampleColor()*2,light=sampleColor()*16,value=sampleColor()*1.5;
        switch(uint(sampleValue()*8)){
        case 0: referenceIncident(light); addIncident(light); break;
        case 1: referenceDirect(brdf,light); addDirect(brdf,light); break;
        case 2: referenceAttenuate(value); attenuate(value); break;
        case 3: referenceReflect(); compactReflect(); break;
        case 4: referenceTransmit(); compactTransmit(); break;
        case 5: {
            float factor=sampleValue()*2;
            referenceScatter(brdf,factor); compactScatter(brdf,factor); break;
        }
        case 6:
            referenceAttenuate(value); attenuate(value);
            if(referenceClass==0u) referenceClass=1u;
            if(pathClass==0u) pathClass=1u;
            referenceIncident(light); addIncident(light); break;
        case 7: {
            float metal=sampleValue(),strength=sampleValue()*2;
            referenceAmbient(value,metal,strength); addAmbient(value,metal,strength); break;
        }
        }
        valid=valid && equalTransport(radianceD+radianceS+radianceT+radianceE,rrRadiance) &&
            equalTransport(referenceThroughput(),compactThroughput());
    }
#endif
#ifdef PT_RR_CORRUPT
    valid=false; // Negative control: the readback must detect this mismatch.
#endif
    imageStore(resultImage,p,vec4(valid ? 0:1,0,0,1));
}
