#version 460
#extension GL_GOOGLE_include_directive : require
#include "../code/renderer_vulkan/shaders/rt_software_trace.glsl"
layout(local_size_x = 64) in;
struct Query { vec4 origin; vec4 direction; vec4 trees; vec4 result; };
layout(set = 0, binding = 4, std430) buffer Queries { Query queries[]; };
layout(push_constant) uniform Count { uint count; } pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    Query q = queries[i];
    queries[i].result.x = traceScene(q.trees, q.origin.xyz, q.direction.xyz, q.origin.w, false);
    queries[i].result.y = traceScene(q.trees, q.origin.xyz, q.direction.xyz, q.origin.w, true);
}
