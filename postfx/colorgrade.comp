#version 450
layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
layout(set=0,binding=0) uniform sampler2D scene;
layout(rgba8,set=0,binding=1) writeonly uniform image2D resultImage;
layout(push_constant) uniform Effect {
    vec4 extentTimeFrame; // output width, height, seconds, frame index
    vec4 values0;        // exposure, saturation, contrast, unused
    vec4 values1;
} effect;
void main() {
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel,ivec2(effect.extentTimeFrame.xy)))) return;
    vec4 source=textureLod(scene,(vec2(pixel)+0.5)/effect.extentTimeFrame.xy,0);
    vec3 color=source.rgb*exp2(effect.values0.x);
    float luma=dot(color,vec3(0.2126,0.7152,0.0722));
    color=mix(vec3(luma),color,effect.values0.y);
    color=(color-0.5)*effect.values0.z+0.5;
    imageStore(resultImage,pixel,vec4(clamp(color,0,1),source.a));
}
