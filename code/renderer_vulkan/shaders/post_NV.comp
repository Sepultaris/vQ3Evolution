// Panoramic NV goggles: soft overlapping tubes, phosphor response and grain.
#version 450
#extension GL_GOOGLE_include_directive : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform sampler2D inputImage;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outputImage;
layout(push_constant) uniform NVPush {
    float gain;
    float grain;
    float grainScale;
    float time;
    uint tint;       // 0 = green phosphor, 1 = cool white phosphor
    uint debug;      // monochrome signal, without optics or grain
    float vignette;
    float pad;
} pc;
#include "post_nv_look.glsl"

vec3 nvRead(ivec2 p, ivec2 dims) {
    // NV always writes at display resolution, including when the scene is
    // half-resolution without DLAA. Same-size inputs land on texel centres.
    vec2 uv = (vec2(clamp(p, ivec2(0), dims - 1)) + 0.5) / vec2(dims);
    return textureLod(inputImage, uv, 0).rgb;
}
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dims = imageSize(outputImage);
    if (any(greaterThanEqual(p, dims))) return;
    vec3 c = nvRead(p, dims);
    float luminance = nvLuminance(c);
    if (pc.debug != 0u) {
        imageStore(outputImage, p, vec4(vec3(nvSignal(luminance, pc.gain)), 1.0));
        return;
    }

    // Small Gaussian diffusion supplies phosphor glow even without global
    // bloom. Fixed nine-tap footprint, with no additional pass or buffer.
    int stepSize = max(1, int(round(float(dims.y) / 240.0)));
    float softened = 4.0 * luminance;
    for (int y = -1; y <= 1; ++y) for (int x = -1; x <= 1; ++x) {
        if (x == 0 && y == 0) continue;
        float weight = (x == 0 || y == 0) ? 2.0 : 1.0;
        softened += weight * nvLuminance(nvRead(p + ivec2(x, y) * stepSize, dims));
    }
    softened /= 16.0;
    float halo = max(softened - 0.45, 0.0) * 0.22;
    float signal = nvSignal(mix(luminance, softened, 0.08) + halo, pc.gain);
    vec2 cell = floor(vec2(p) / max(pc.grainScale, 1.0));
    float noise = nvNoise(cell, pc.time) * pc.grain * (0.06 + 0.10 * (1.0 - signal));
    signal = clamp(signal + noise * smoothstep(0.0, 0.04, signal), 0.0, 1.0);
    vec3 phosphor = nvPhosphor(signal, pc.tint);
    vec2 q = ((vec2(p) + 0.5) / vec2(dims)) * 2.0 - 1.0;
    float aspect = float(dims.x) / float(dims.y);
    q.x *= aspect;
    float mask = mix(1.0, nvLensMask(q, aspect), pc.vignette);
    // Barely visible unaided periphery. The HUD is drawn later, unchanged.
    imageStore(outputImage, p, vec4(clamp(mix(c * 0.025, phosphor, mask), 0.0, 1.0), 1.0));
}
