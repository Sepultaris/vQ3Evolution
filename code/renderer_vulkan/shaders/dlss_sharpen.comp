#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D inputImage;
layout(rgba8, set = 0, binding = 1) uniform writeonly image2D outputImage;

layout(push_constant) uniform SharpenPush {
	float sharpness;
	uint width;
	uint height;
} pc;

ivec2 limitCoordinate(ivec2 coordinate)
{
	return clamp(coordinate, ivec2(0), ivec2(pc.width, pc.height) - ivec2(1));
}

vec3 readColor(ivec2 coordinate)
{
	return texelFetch(inputImage, limitCoordinate(coordinate), 0).rgb;
}

void main()
{
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	if (pixel.x >= int(pc.width) || pixel.y >= int(pc.height))
		return;

	vec4 centerSample = texelFetch(inputImage, pixel, 0);
	vec3 center = centerSample.rgb;
	vec3 north = readColor(pixel + ivec2(0, -1));
	vec3 south = readColor(pixel + ivec2(0, 1));
	vec3 east = readColor(pixel + ivec2(1, 0));
	vec3 west = readColor(pixel + ivec2(-1, 0));

	/* Contrast-adaptive cross sharpening. The adaptive weight suppresses
	 * halos near saturated local extrema while retaining fine detail. */
	vec3 localMin = min(center, min(min(north, south), min(east, west)));
	vec3 localMax = max(center, max(max(north, south), max(east, west)));
	vec3 adaptive = sqrt(clamp(min(localMin, vec3(1.0) - localMax) /
		max(localMax, vec3(1.0 / 65535.0)), vec3(0.0), vec3(1.0)));
	vec3 weight = adaptive * (-0.2 * clamp(pc.sharpness, 0.0, 1.0));
	vec3 sharpened = (center + weight * (north + south + east + west)) /
		(vec3(1.0) + 4.0 * weight);

	imageStore(outputImage, pixel,
		vec4(clamp(sharpened, vec3(0.0), vec3(1.0)), centerSample.a));
}
