#version 460
#extension GL_EXT_ray_query : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT sceneAS;
layout(set = 0, binding = 1) uniform sampler2D sceneColor;
layout(set = 0, binding = 2) uniform sampler2D sceneDepth;
layout(set = 0, binding = 3, rgba8) uniform writeonly image2D shadowedColor;

layout(push_constant) uniform RayTracingConstants {
	vec4 cameraOriginAndNear;
	vec4 cameraForwardAndFar;
	vec4 cameraRightAndProjectionX;
	vec4 cameraUpAndProjectionY;
	vec4 sunDirectionAndStrength;
	vec4 parameters; /* x: ray bias, y: max distance, zw: projection jitter */
} pc;

void main()
{
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(shadowedColor);
	if (any(greaterThanEqual(pixel, size)))
		return;

	vec4 color = texelFetch(sceneColor, pixel, 0);
	float depth = texelFetch(sceneDepth, pixel, 0).r;
	/* DEPTH_RANGE_WEAPON maps first-person models into 0.0-0.3. They are
	 * composited with a different projection and cannot use world depth. */
	if (depth <= 0.300001 || depth >= 0.999999) {
		imageStore(shadowedColor, pixel, color);
		return;
	}

	vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(size);
	vec2 ndc = uv * 2.0 - 1.0;
	float nearPlane = pc.cameraOriginAndNear.w;
	float farPlane = pc.cameraForwardAndFar.w;
	float linearDepth = (nearPlane * farPlane) /
		max(farPlane - depth * (farPlane - nearPlane), 0.0001);
	float viewX = (ndc.x + pc.parameters.z) * linearDepth /
		pc.cameraRightAndProjectionX.w;
	float viewY = (ndc.y + pc.parameters.w) * linearDepth /
		pc.cameraUpAndProjectionY.w;
	vec3 world = pc.cameraOriginAndNear.xyz +
		pc.cameraForwardAndFar.xyz * linearDepth +
		pc.cameraRightAndProjectionX.xyz * viewX +
		pc.cameraUpAndProjectionY.xyz * viewY;

	vec3 lightDirection = normalize(pc.sunDirectionAndStrength.xyz);
#ifdef RT_DEBUG_REPROJECTION
	vec3 primary = world - pc.cameraOriginAndNear.xyz;
	rayQueryEXT primaryQuery;
	rayQueryInitializeEXT(primaryQuery, sceneAS, gl_RayFlagsOpaqueEXT,
		0xff, pc.cameraOriginAndNear.xyz, nearPlane,
		normalize(primary), 16384.0);
	while (rayQueryProceedEXT(primaryQuery)) {}
	vec3 debugColor = vec3(0, 0, 1);
	if (rayQueryGetIntersectionTypeEXT(primaryQuery, true) !=
		gl_RayQueryCommittedIntersectionNoneEXT) {
		float error = abs(rayQueryGetIntersectionTEXT(primaryQuery, true) - length(primary));
		debugColor = mix(vec3(0, 1, 0), vec3(1, 0, 0), clamp(error / 4.0, 0.0, 1.0));
	}
	imageStore(shadowedColor, pixel, vec4(debugColor, 1));
	return;
#endif
	rayQueryEXT query;
	rayQueryInitializeEXT(query, sceneAS,
		gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT,
		0xff, world + lightDirection * pc.parameters.x,
		0.0, lightDirection, pc.parameters.y);
	while (rayQueryProceedEXT(query)) {}

	bool occluded = rayQueryGetIntersectionTypeEXT(query, true) !=
		gl_RayQueryCommittedIntersectionNoneEXT;
	if (occluded) {
		float visibility = 1.0 - clamp(pc.sunDirectionAndStrength.w, 0.0, 1.0);
		color.rgb *= visibility;
	}
	imageStore(shadowedColor, pixel, color);
}
