# -----------------------------------------------------------------------------
# VQ3 Evolution: generated build trees and local build configuration
# -----------------------------------------------------------------------------
/build/
/build-*/
/dist/
/tests/
/.build-tmp/
/Makefile.local
/compile_commands.json
/.cache/

# Standalone generated audit/test output and older release/backup trees.
# The validation harness is intentionally local-only; keep the entire tests/
# directory out of source and binary release commits.
/audit/
/audits/
/audit-*/
/*-audit/
/test-output/
/test-results/
/test-results-*/
/captures/
/backups/
/backup-*/
/old-build*/
/release/
/release-*/
TestResults/
test-results/
test-output/
coverage/
.coverage
.coverage.*
htmlcov/
# Loose post-effect SPIR-V is compiled into build/dist, not checked in.
# Existing *.cspv/*.vspv/*.fspv renderer inputs deliberately remain eligible.
*.spv

# Accidental out-of-tree compiler output / downloaded binary dependencies.
# Existing tracked libraries under code/libs remain tracked; new vendored
# binaries require explicit review instead of an accidental bulk add.
*.o
*.obj
*.d
*.pdb
*.ilk
*.exp
*.idb
*.exe
*.dll
*.so
*.so.*
*.dylib
*.a
*.lib

# Build archives created at the repository root
/debug-*.zip
/release-*.zip
/build-*.zip

# -----------------------------------------------------------------------------
# Local game data and runtime output
# -----------------------------------------------------------------------------
# Do not commit proprietary Quake III data or locally assembled packages.
*.pk3
*.pk3dir/
# Compiled/extracted game modules are build output, not source.
*.qvm

# Per-user engine state and output. Source-controlled example configs should use
# a more specific filename instead of q3config.cfg or autoexec.cfg.
q3config.cfg
autoexec.cfg
vq3e-rendering.cfg
qconsole.log
games.log
crashlog.txt
stdout.log
stderr.log
imgui.ini
*.log
q3history
q3history.*
condump*.txt
*.dmp
# NVIDIA captures can embed shaders, game resources and local process details.
*.nsys-rep
*.qdstrm
*.ngfx-gputrace
*.ngfx-capture
*.nv-gpudmp
*.rdc
*.dm_*
screenshots/
videos/
demos/

# -----------------------------------------------------------------------------
# Temporary and editor files
# -----------------------------------------------------------------------------
*.swp
*.swo
*~
*.tmp
*.temp
*.bak
*.orig
*.rej
*.patch~
*tags

# Windows
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/

# macOS
.Spotlight-V100/
.Trashes/
._*
.AppleDouble
.DS_Store
.LSOverride
Icon?

# -----------------------------------------------------------------------------
# Visual Studio / VS Code / JetBrains
# -----------------------------------------------------------------------------
/.vs/
/.vscode/
.idea/
*.sdf
*.opensdf
*.suo
*.user
*.VC.db
*.VC.opendb
*.opendb
*.ipch
*.aps
*.ncb
*.sbr
*.tlog
*.lastbuildstate

# -----------------------------------------------------------------------------
# Python test/generator caches
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Local credentials and downloaded neural-model weights (never source).
.env
.env.*
!.env.example
!.env.sample
*.safetensors
*.onnx
*.pth
*.pt

