# Visual Studio / VS Code / JetBrains
# -----------------------------------------------------------------------------
/.vs/
/.vscode/
.idea/
*.sdf
*.opensdf
*.suo
*.user
*.VC.db
*.VC.opendb
*.opendb
*.ipch
*.aps
*.ncb
*.sbr
*.tlog
*.lastbuildstate

# -----------------------------------------------------------------------------
# Python test/generator caches
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Local credentials and downloaded neural-model weights (never source).
.env
.env.*
!.env.example
!.env.sample
*.safetensors
*.onnx
*.pth
*.pt

